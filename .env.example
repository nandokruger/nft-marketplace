# KURIO NFT Marketplace — Variáveis de Ambiente
# Copie este arquivo para .env.local para customizações locais

# Nome da Aplicação
VITE_APP_NAME="KURIO NFT Marketplace"

# Flag de controle do Mock Service Worker (padrão true para desenvolvimento e preview autônomo)
VITE_ENABLE_MSW=true

# URL base do servidor Socket.IO (vazio para usar a mesma origem do browser: window.location.origin)
VITE_SOCKET_URL=""

# Latência simulada padrão para requisições do MSW (em milissegundos)
VITE_DEFAULT_LATENCY_MS=150

# Cenário de caos inicial (opcional: default, slow-network, out-of-order, http-500, session-expired, etc.)
VITE_INITIAL_SCENARIO="default"
